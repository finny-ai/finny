{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#09090b",
    "darkPanel": "#111114",
    "darkElement": "#18181d",
    "darkBorder": "#27272f",
    "darkBorderSubtle": "#1a1a20",
    "darkBorderActive": "#6366f1",
    "darkText": "#fafafa",
    "darkTextMuted": "#a1a1aa",
    "darkTextSubtle": "#71717a",
    "darkPrimary": "#6366f1",
    "darkPrimaryHover": "#818cf8",
    "darkSecondary": "#a1a1aa",
    "darkAccent": "#a78bfa",
    "darkSuccess": "#22c55e",
    "darkWarning": "#f59e0b",
    "darkError": "#ef4444",
    "darkInfo": "#60a5fa",
    "darkCyan": "#4fd6be",
    "darkYellow": "#fcd53a",
    "darkPurple": "#a753ae",
    "lightBg": "#fafafa",
    "lightPanel": "#f4f4f5",
    "lightElement": "#ffffff",
    "lightBorder": "#e4e4e7",
    "lightBorderSubtle": "#f1f1f4",
    "lightBorderActive": "#6366f1",
    "lightText": "#09090b",
    "lightTextMuted": "#52525b",
    "lightTextSubtle": "#a1a1aa",
    "lightPrimary": "#6366f1",
    "lightPrimaryHover": "#4f46e5",
    "lightSecondary": "#52525b",
    "lightAccent": "#7c3aed",
    "lightSuccess": "#16a34a",
    "lightWarning": "#d97706",
    "lightError": "#dc2626",
    "lightInfo": "#2563eb",
    "lightCyan": "#318795",
    "lightYellow": "#b0851f",
    "lightPurple": "#a753ae"
  },
  "theme": {
    "primary": { "dark": "darkPrimary", "light": "lightPrimary" },
    "secondary": { "dark": "darkSecondary", "light": "lightSecondary" },
    "accent": { "dark": "darkAccent", "light": "lightAccent" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkWarning", "light": "lightWarning" },
    "success": { "dark": "darkSuccess", "light": "lightSuccess" },
    "info": { "dark": "darkInfo", "light": "lightInfo" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBorderActive", "light": "lightBorderActive" },
    "borderSubtle": { "dark": "darkBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "darkSuccess", "light": "lightSuccess" },
    "diffRemoved": { "dark": "darkError", "light": "lightError" },
    "diffContext": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "diffHunkHeader": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "diffHighlightAdded": { "dark": "#4fd6be", "light": "#4db380" },
    "diffHighlightRemoved": { "dark": "#e26a75", "light": "#f52a65" },
    "diffAddedBg": { "dark": "#0f2a1b", "light": "#d5e5d5" },
    "diffRemovedBg": { "dark": "#2d1515", "light": "#f7d8db" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightPanel" },
    "diffLineNumber": { "dark": "darkElement", "light": "lightElement" },
    "diffAddedLineNumberBg": { "dark": "#132218", "light": "#c5d5c5" },
    "diffRemovedLineNumberBg": { "dark": "#241212", "light": "#e7c8cb" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLink": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownLinkText": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownCode": { "dark": "darkSuccess", "light": "lightSuccess" },
    "markdownBlockQuote": { "dark": "darkYellow", "light": "lightYellow" },
    "markdownEmph": { "dark": "darkYellow", "light": "lightYellow" },
    "markdownStrong": { "dark": "darkWarning", "light": "lightWarning" },
    "markdownHorizontalRule": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "markdownListItem": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownListEnumeration": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownImage": { "dark": "darkPrimary", "light": "lightPrimary" },
    "markdownImageText": { "dark": "darkCyan", "light": "lightCyan" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkTextMuted", "light": "lightTextMuted" },
    "syntaxKeyword": { "dark": "darkPrimary", "light": "lightPrimary" },
    "syntaxFunction": { "dark": "darkCyan", "light": "lightCyan" },
    "syntaxVariable": { "dark": "darkError", "light": "lightError" },
    "syntaxString": { "dark": "darkSuccess", "light": "lightSuccess" },
    "syntaxNumber": { "dark": "darkWarning", "light": "lightWarning" },
    "syntaxType": { "dark": "darkYellow", "light": "lightYellow" },
    "syntaxOperator": { "dark": "darkPurple", "light": "lightPurple" },
    "syntaxPunctuation": { "dark": "darkText", "light": "lightText" }
  }
}
