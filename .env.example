# Finny Data Agent environment template
#
# Copy this file to `.env` locally and fill in only the values your data-agent
# instructions need. `.env` and `.env.*` are ignored by git; keep real secrets
# out of committed files.
#
# Data Agent bash automatically loads `.env` values from:
# - the repo root
# - the active algo root
# - the active data workdir

# Public sources such as yfinance and Binance public klines do not require keys.

# Generic API source examples
MARKET_DATA_URL=
MARKET_DATA_TOKEN=
POLYGON_API_KEY=

# Perplexity-backed web research (used by Finny's websearch tool)
# Optional: force the websearch backend. When unset, a Perplexity key stored in
# Settings (auth.json under provider id `perplexity`) also enables Perplexity.
# Set the provider value to `perplexity` and supply a key to opt in via env.
OPENCODE_WEBSEARCH_PROVIDER=
# Env override for the key. Prefer Settings → Data Sources → Web search or
# Settings → Providers → Perplexity, which store the key in local auth.json.
PERPLEXITY_API_KEY=

# Alpaca data examples
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Enterprise source examples
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
BLOOMBERG_HOST=
BLOOMBERG_API_KEY=
